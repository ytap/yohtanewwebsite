---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);


// concept / technical / credits は空行で段落に分ける
const paragraphs = (text) => (text ?? '').trim().split(/\n\s*\n/).filter(Boolean);
---

<Layout title={`${d.title}: Yohta Kitagawa`}>
    <div class="main-container">
        <header class="project-header">
            <h1 class="project-title">{d.title}</h1>
            <p class="project-meta">{d.contributors} · {d.year}{d.role ? ` · ${d.role}` : ''}</p>
        </header>

        <section class="project-top">
            <div class="loop-block">
                <div class="loop-wrapper">
                    {d.loop ? (
                        <video
                            class={d.fit === 'contain' ? 'loop-media is-contain' : 'loop-media'}
                            poster={d.poster}
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="auto"
                        >
                            <source src={d.loop.replace('.mp4', '.webm')} type="video/webm" />
                            <source src={d.loop} type="video/mp4" />
                        </video>
                    ) : (
                        <img class={d.fit === 'contain' ? 'loop-media is-contain' : 'loop-media'} src={d.poster} alt={d.title} />
                    )}
                    <p class="loop-caption">{d.oneLiner}</p>
                </div>
            </div>

            <div class="top-text bordered-block">
                <p class="one-liner">{d.oneLiner}</p>
                {paragraphs(d.concept).map((p) => <p class="body-text">{p}</p>)}
            </div>
        </section>

        <section class="project-middle">
            <div class="middle-left">
                <div class="bordered-block">
                    <h2 class="section-heading">Technical Details</h2>
                    <ul class="technical-list">
                        {/* 項目内にリンクを書けるようにHTMLとして出力する */}
                        {d.technical.map((item) => <li set:html={item} />)}
                    </ul>
                </div>

                {d.recognition.length > 0 && (
                    <div class="bordered-block">
                        <h2 class="section-heading">Recognition</h2>
                        <ul class="recognition-list">
                            {d.recognition.map((item) => (
                                <li>
                                    {item.url ? (
                                        <a href={item.url} target="_blank" rel="noopener noreferrer">{item.text}</a>
                                    ) : (
                                        item.text
                                    )}
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>

            <div class="middle-right">
                {d.archiveVideo ? (
                    <div class="archive-block">
                        <video class="archive-video" src={d.archiveVideo} poster={d.poster} controls playsinline></video>
                    </div>
                ) : (
                    <p class="archive-pending">Documentation currently in progress...</p>
                )}
                {d.fullVideoUrl && (
                    <p class="full-link">
                        <a href={d.fullVideoUrl} target="_blank" rel="noopener noreferrer">→ Watch the full video</a>
                    </p>
                )}
            </div>
        </section>

        {d.extraImage && (
            <section class="project-extra">
                <img src={d.extraImage} alt={d.extraCaption ?? d.title} />
                {d.extraCaption && <p class="extra-caption">{d.extraCaption}</p>}
            </section>
        )}

        <section class="project-process bordered-block">
            <h2 class="section-heading">Process</h2>
            <div class="body-text process-body">
                <Content />
            </div>
        </section>

        <section class="project-credits bordered-block">
            <h2 class="section-heading">Credits</h2>
            {/* クレジット内にリンクを書けるようにHTMLとして出力する */}
            {paragraphs(d.credits).map((p) => <p class="body-text" set:html={p} />)}
        </section>

        {d.paper && (
            <section class="project-paper bordered-block">
                <h2 class="section-heading">Paper</h2>
                <div class="paper-embed">
                    <iframe src={`${d.paper}#zoom=page-width`} title={`${d.title} paper`}></iframe>
                </div>
                <p class="paper-link"><a href={d.paper} target="_blank" rel="noopener noreferrer">→ Open as PDF</a></p>
            </section>
        )}
    </div>
</Layout>

<script>
    import { initElementBorder, initElementUnderline } from '../../scripts/projectCardBorder.js';

    function initBorders() {
        document.querySelectorAll('.bordered-block').forEach(block => initElementBorder(block));
        document.querySelectorAll('.section-heading, .one-liner').forEach(el => initElementUnderline(el));
    }

    document.addEventListener('astro:page-load', initBorders);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBorders);
    } else {
        initBorders();
    }
</script>

<style>
    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 24px 0 80px 0;
    }

    .project-title {
        font-size: 32px;
        font-weight: normal;
        color: #333;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .project-meta {
        font-size: 16px;
        color: #888;
        margin: 0 0 32px 0;
    }

    /* トップの作品カードと同じ、手描き風の点線で囲うブロック */
    .bordered-block {
        position: relative;
        padding: 20px;
        box-sizing: border-box;
    }

    .bordered-block > :last-child {
        margin-bottom: 0;
    }

    .middle-left {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* 見出しは文字幅ぶんだけ、下に動く点線を引く (線はcanvasで描画) */
    .section-heading,
    .one-liner {
        display: inline-block;
        position: relative;
        padding-bottom: 5px;
    }

    .section-heading {
        font-size: 24px;
        font-weight: normal;
        color: #333;
        margin: 0 0 16px 0;
    }

    .body-text {
        font-size: 20px;
        line-height: 1.6;
        color: #333;
        margin: 0 0 20px 0;
    }

    /* --- 上段: 左にループ、右に1行説明とコンセプト --- */
    .project-top {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        margin-bottom: 56px;
    }

    .loop-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background-color: #f0f0f0;
    }

    .loop-media {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* 図版など、切りたくない画像は余白付きで全体を出す (背景は白) */
    .loop-media.is-contain {
        object-fit: contain;
        background-color: #fff;
    }

    /* ループにhoverしたときだけ1行説明を重ねて出す */
    .loop-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        margin: 0;
        padding: 16px;
        font-size: 18px;
        color: #fff;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0));
        opacity: 0;
        transition: opacity 0.25s ease;
        pointer-events: none;
    }

    .loop-wrapper:hover .loop-caption {
        opacity: 1;
    }

    .one-liner {
        font-size: 24px;
        line-height: 1.4;
        color: #333;
        margin: 0 0 24px 0;
    }

    /* --- 中段: 左にTechnicalとRecognition、右にアーカイブ動画 --- */
    .project-middle {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        margin-bottom: 56px;
    }

    .technical-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
    }

    .technical-list li {
        margin-bottom: 10px;
        padding-left: 18px;
        position: relative;
    }

    .technical-list a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .technical-list a:hover {
        color: #888;
    }

    .technical-list li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: #888;
    }

    /* Technical Details と同じ位置・同じ記号で揃える */
    .recognition-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
    }

    .recognition-list li {
        margin-bottom: 10px;
        padding-left: 18px;
        position: relative;
    }

    .recognition-list li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: #888;
    }

    .recognition-list a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .recognition-list a:hover {
        color: #888;
    }

    .archive-video {
        width: 100%;
        aspect-ratio: 16 / 9;
        display: block;
        background-color: #000;
    }

    .full-link {
        margin: 12px 0 0 0;
        font-size: 18px;
    }

    .full-link a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .full-link a:hover {
        color: #888;
    }

    .archive-pending {
        margin: 0;
        font-size: 18px;
        color: #888;
    }

    .project-extra {
        margin-bottom: 24px;
    }

    .project-extra img {
        width: 100%;
        max-width: 860px;
        height: auto;
        display: block;
    }

    .extra-caption {
        margin: 12px 0 0 0;
        font-size: 18px;
        color: #555;
    }

    /* --- 下段 --- */
    .project-process {
        margin-bottom: 56px;
    }

    .process-body :global(p) {
        font-size: 20px;
        line-height: 1.6;
        color: #333;
        margin: 0 0 20px 0;
    }

    .project-credits a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .project-credits a:hover {
        color: #888;
    }

    .process-body :global(a) {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .project-paper {
        margin-top: 24px;
    }

    /* 論文はスクロールできる埋め込みのまま。枠は紙に近い縦横比にして倍率を安定させる */
    .paper-embed {
        width: 100%;
        max-width: 1100px;
        aspect-ratio: 1 / 1.32;
        margin: 0 auto 16px auto;
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .paper-embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }

    /* モバイル (特にiOS Safari) はPDFのiframe表示が不安定なため、リンクだけ出す */
    @media (max-width: 700px) {
        .paper-embed {
            display: none;
        }
    }

    .paper-link {
        margin: 0;
        text-align: center;
        font-size: 18px;
    }

    .paper-link a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .paper-link a:hover {
        color: #888;
    }

    @media (max-width: 700px) {
        .project-top,
        .project-middle {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }
</style>
