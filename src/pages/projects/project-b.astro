---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

const projectTitle = 'Contact Membrane';
const projectDescription = `An interface for interspecies listening. A human and a mealworm beetle share a tensioned paper surface, where contact microphones and an IMU magnify the insect's micro-movements into granular, spatialized sound based on the mealworm beetle's Umwelt.`;
---

<ProjectLayout
    title={projectTitle}
    image="/yohtanewwebsite/assets/mealworm1.png"
    note="Paper under submission. Contact ykitagawa[at]keio.jp"
>
    <VideoEmbed drive="1UhtPcfvM9erCrSRZ4z_Ddz82mA2iTNQ-" title={projectTitle} />

    <p>{projectDescription}</p>
</ProjectLayout>
