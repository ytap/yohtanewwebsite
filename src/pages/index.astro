---
import Layout from '../layouts/Layout.astro';

import { getCollection } from 'astro:content';
import { pdfPageImages } from '../utils/pdfPages.js';
import cvLinks from '../data/cv-links.json';
import { isProjectAvailable } from '../utils/projectRelease.js';

const publicVersion = Astro.props.publicVersion ?? false;
const pageBase = publicVersion ? '/yohtanewwebsite/public' : '/yohtanewwebsite';

// CVもページ画像で表示し、PDF内のリンクは同じ位置に透明な<a>を重ねて再現する
const cvPages = pdfPageImages('cv');

// 作品データは src/content/projects/*.md から読む (トップと個別ページで共通)
const projects = (await getCollection('projects')).filter((project) => isProjectAvailable(project)).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).map((project) => ({
    title: project.data.title,
    description: project.data.oneLiner,
    image: project.data.homePoster ?? project.data.poster,
    loop: project.id === 'knot-music' ? undefined : (project.data.homeLoop ?? project.data.loop),
    fit: project.data.homeFit ?? project.data.fit,
    link: project.data.published ? `${pageBase}/projects/${project.id}` : null,
}));

const [featureProject, ...subProjects] = featuredProjects;
const moreProjects = projects.filter((project) =>
    project.data.published && !project.data.featured && project.data.poster
);
---

<Layout isHome={true} publicVersion={publicVersion} noindex={!publicVersion} preloadImages={featuredProjects.map((project) => project.image)}>
    <div class="main-container">
        <header class="hero-section">
            <h1 class="site-title">Yohta Kitagawa</h1>
            <div class="divider-wrapper">
                <canvas id="divider-canvas" class="procedural-divider" aria-hidden="true"></canvas>
            </div>
        </header>

        <section class="intro-section" id="vision">
            <div class="intro-photo">
                <div class="intro-photo-inner">
                    <img src="/yohtanewwebsite/assets/portrait.jpg" alt="Yohta Kitagawa" class="intro-photo-img" />
                </div>
            </div>
            <div class="intro-text">
                <div class="canvas-wrapper">
                    <canvas id="about-canvas" class="procedural-about"></canvas>
                </div>
                <p class="intro-contact"><a href={`${pageBase}/vision`}>→ More on Mediating Animacy</a></p>
                <div class="contact-row">
                    <p class="intro-contact">Feel free to contact me at <a href="mailto:ykitagawa@keio.jp">ykitagawa@keio.jp</a> / <a href="https://instagram.com/yohta_kitagawa" target="_blank" rel="noopener noreferrer">Instagram</a></p>
                </div>
            </div>
        </section>

        <section class="featured-section" id="projects">
            <div class="sound-gain">
                <label for="sound-gain">Audio</label>
                <input id="sound-gain" type="range" min="0" max="100" step="1" value="0" aria-label="Project audio volume" aria-valuetext="Muted" />
            </div>

            <div class="projects-layout">
                <a href={featureProject.link} class="project-block project-block-feature">
                    <div class="image-wrapper">
                        {featureProject.loop ? (
                            <>
                                <img src={featureProject.image} alt="" aria-hidden="true" class={featureProject.fit === 'contain' ? 'project-img first-frame is-contain' : 'project-img first-frame'} />
                                <video class={featureProject.fit === 'contain' ? 'project-img project-video is-contain' : 'project-img project-video'} poster={featureProject.image} autoplay muted loop playsinline preload="auto">
                                    <source src={featureProject.loop.replace('.mp4', '.webm')} type="video/webm" />
                                    <source src={featureProject.loop} type="video/mp4" />
                                </video>
                            </>
                        ) : (
                            <img src={featureProject.image} alt={featureProject.title} class={featureProject.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                        )}
                    </div>
                    <div class="project-text-content">
                        <h3 class="project-block-title">{featureProject.title}</h3>
                        <p class="project-block-desc">{featureProject.description}</p>
                    </div>
                </a>

                <div class="project-sub-grid">
                    {subProjects.map((project) => (
                        project.link ? (
                            <a href={project.link} class="project-block project-block-sub">
                                <div class="image-wrapper">
                                    {project.loop ? (
                                        <>
                                            <img src={project.image} alt="" aria-hidden="true" class={project.fit === 'contain' ? 'project-img first-frame is-contain' : 'project-img first-frame'} />
                                            <video class={project.fit === 'contain' ? 'project-img project-video is-contain' : 'project-img project-video'} poster={project.image} autoplay muted loop playsinline preload="auto">
                                                <source src={project.loop.replace('.mp4', '.webm')} type="video/webm" />
                                                <source src={project.loop} type="video/mp4" />
                                            </video>
                                        </>
                                    ) : (
                                        <img src={project.image} alt={project.title} class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                                    )}
                                </div>
                                <div class="project-text-content">
                                    <h3 class="project-block-title">{project.title}</h3>
                                </div>
                            </a>
                        ) : (
                            <div class="project-block project-block-sub is-upcoming">
                                <div class="image-wrapper">
                                    {project.loop ? (
                                        <>
                                            <img src={project.image} alt="" aria-hidden="true" class={project.fit === 'contain' ? 'project-img first-frame is-contain' : 'project-img first-frame'} />
                                            <video class={project.fit === 'contain' ? 'project-img project-video is-contain' : 'project-img project-video'} poster={project.image} autoplay muted loop playsinline preload="auto">
                                                <source src={project.loop.replace('.mp4', '.webm')} type="video/webm" />
                                                <source src={project.loop} type="video/mp4" />
                                            </video>
                                        </>
                                    ) : (
                                        <img src={project.image} alt={project.title} class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                                    )}
                                </div>
                                <div class="project-text-content">
                                    <h3 class="project-block-title">{project.title}</h3>
                                </div>
                            </div>
                        )
                    ))}
                </div>
            </div>
        </section>

        <section class="more-projects-section" aria-label="More projects">
            <div class="project-marquee">
                <div class="project-marquee-track">
                    {[0, 1].map((copy) => (
                        <div class="project-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                            {moreProjects.map((project) => (
                                <a class="project-marquee-item" href={`${pageBase}/projects/${project.id}/`} aria-label={project.data.title} tabindex={copy === 1 ? -1 : undefined}>
                                    <img src={project.data.poster} alt="" loading="lazy" decoding="async" />
                                    <span>{project.data.title}</span>
                                </a>
                            ))}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <nav class="view-more" aria-labelledby="view-more-heading">
            <h2 id="view-more-heading">View more</h2>
            <p>
                <a href={`${pageBase}/projects/`}><span aria-hidden="true">→</span> Projects</a>,
                <a href={`${pageBase}/updates/`}><span aria-hidden="true">→</span> Updates</a>,
                <a href={`${pageBase}/travel-news/#upcoming`}><span aria-hidden="true">→</span> Events</a>
            </p>
        </nav>

        <section class="cv-section" id="cv">
            <div class="cv-pages">
                {cvPages.map((src, i) => (
                    <div class="cv-page">
                        <img src={src} alt={`Yohta Kitagawa CV, page ${i + 1}`} loading="lazy" />
                        {i === 0 && cvLinks.map((link) => (
                            <a
                                class="cv-page-link"
                                href={publicVersion && link.href === 'https://ytap.github.io/yohtanewwebsite/' ? `${pageBase}/` : link.href}
                                aria-label={link.label}
                                title={link.label}
                                target="_blank"
                                rel="noopener noreferrer"
                                style={`left:${link.left}%;top:${link.top}%;width:${link.width}%;height:${link.height}%;`}
                            ></a>
                        ))}
                    </div>
                ))}
            </div>
            <p class="cv-link">
                <a href="/yohtanewwebsite/assets/Yohta_Kitagawa_CV.pdf">→ Open CV as PDF</a>
                <a class="cv-download" href="/yohtanewwebsite/assets/Yohta_Kitagawa_CV.pdf" download="Yohta_Kitagawa_CV.pdf">Download PDF</a>
            </p>

        </section>

        </div>
    </Layout>

<script>
    import '../scripts/pages/main-canvas.js';

    // 画面の近くにある作品だけ読み込み・再生する
    function setupVisibleVideos() {
        if (document.body.dataset.visibleVideosInitialized === 'true') return;
        const videos = Array.from(document.querySelectorAll('.project-block video'));
        if (videos.length === 0) return;
        document.body.dataset.visibleVideosInitialized = 'true';

        const visible = new Set();
        videos.forEach((video) => {
            let revealRequested = false;
            const reveal = () => {
                if (revealRequested) return;
                revealRequested = true;
                if (video.requestVideoFrameCallback) {
                    video.requestVideoFrameCallback(() => video.classList.add('is-playing'));
                } else {
                    video.classList.add('is-playing');
                }
            };
            video.addEventListener('playing', reveal, { once: true });
            if (!video.paused && video.readyState >= 2) reveal();
        });
        const playVisible = (video) => {
            if (document.hidden) return;
            const playback = video.play();
            if (playback && typeof playback.catch === 'function') playback.catch(() => {});
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(({ target, isIntersecting }) => {
                if (isIntersecting) {
                    visible.add(target);
                    playVisible(target);
                } else {
                    visible.delete(target);
                    target.pause();
                    target.muted = true;
                }
            });
        }, { rootMargin: '150px 0px' });

        videos.forEach((video) => observer.observe(video));
        document.addEventListener('visibilitychange', () => {
            videos.forEach((video) => {
                if (document.hidden) video.pause();
                else if (visible.has(video)) playVisible(video);
            });
        });
    }

    // 作品のループ映像: 通常はミュート、hoverしている1本だけ音を出す
    function setupHoverSound() {
        const gain = document.getElementById('sound-gain');
        const blocks = Array.from(document.querySelectorAll('.project-block'));
        if (!(gain instanceof HTMLInputElement) || blocks.length === 0) return;
        if (gain.dataset.hoverSoundInitialized === 'true') return;
        gain.dataset.hoverSoundInitialized = 'true';

        // hoverできない端末 (スマホなど) では音を扱わない
        if (!window.matchMedia('(hover: hover)').matches) return;

        const videos = blocks
            .map(block => ({ block, video: block.querySelector('video') }))
            .filter(entry => entry.video);
        if (videos.length === 0) return;

        let volume = Number(gain.value) / 100;
        let current = null;
        // フェードのタイマーは動画ごとに持つ (共有すると前の動画が鳴りっぱなしになる)
        const fadeTimers = new WeakMap();

        function fadeTo(video, target) {
            const running = fadeTimers.get(video);
            if (running) window.clearInterval(running);
            const id = window.setInterval(() => {
                const step = 0.04;
                const next = target > video.volume ? video.volume + step : video.volume - step;
                const done = target > video.volume ? next >= target : next <= target;
                video.volume = done ? target : next;
                if (done) {
                    window.clearInterval(id);
                    fadeTimers.delete(video);
                    if (target === 0) video.muted = true;
                }
            }, 25);
            fadeTimers.set(video, id);
        }

        function muteNow(video) {
            const running = fadeTimers.get(video);
            if (running) {
                window.clearInterval(running);
                fadeTimers.delete(video);
            }
            video.muted = true;
            video.volume = 0;
        }

        // hover中の1本以外は必ずミュートに戻す
        function enforce() {
            videos.forEach(({ video }) => {
                if (video !== current) {
                    if (!video.muted || video.volume > 0) muteNow(video);
                }
            });
        }

        function stopCurrent() {
            if (!current) return;
            const video = current;
            current = null;
            fadeTo(video, 0);
        }

        function playSound(video) {
            if (volume === 0 || !video) return;
            if (current && current !== video) muteNow(current);
            current = video;
            video.volume = 0;
            video.muted = false;
            fadeTo(video, volume);
            const p = video.play();
            if (p && typeof p.catch === 'function') {
                p.catch(() => {
                    muteNow(video);
                    if (current === video) current = null;
                });
            }
        }

        videos.forEach(({ block, video }) => {
            block.addEventListener('mouseenter', () => playSound(video));
            block.addEventListener('mouseleave', () => {
                if (current === video) stopCurrent();
                else muteNow(video);
            });
        });

        // グリッドの外に出たとき、タブが隠れたときは全部止める
        const section = document.getElementById('projects');
        if (section) {
            section.addEventListener('mouseleave', () => {
                stopCurrent();
                enforce();
            });
        }
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                current = null;
                videos.forEach(({ video }) => muteNow(video));
            }
        });
        window.addEventListener('blur', () => {
            current = null;
            videos.forEach(({ video }) => muteNow(video));
        });

        gain.addEventListener('input', () => {
            volume = Number(gain.value) / 100;
            gain.setAttribute('aria-valuetext', volume === 0 ? 'Muted' : `${gain.value}%`);
            gain.style.setProperty('--gain-level', `${gain.value}%`);
            if (volume === 0) {
                current = null;
                videos.forEach(({ video }) => muteNow(video));
            } else if (current) {
                fadeTo(current, volume);
            }
        });
    }

    function setupProjectMarquee() {
        const marquee = document.querySelector('.project-marquee');
        const track = marquee?.querySelector('.project-marquee-track');
        const group = track?.querySelector('.project-marquee-group');
        if (!(marquee instanceof HTMLElement) || !(track instanceof HTMLElement) || !(group instanceof HTMLElement)) return;
        if (marquee.dataset.initialized === 'true') return;
        marquee.dataset.initialized = 'true';

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let hovering = false;
        let focused = false;
        let speed = 1;
        let offset = 0;
        let previousTime = 0;
        let frame = 0;

        // 速度だけを滑らかに変え、位置は連続させる。
        function tick(time) {
            if (!marquee.isConnected || document.hidden || reducedMotion.matches) {
                frame = 0;
                return;
            }
            const elapsed = previousTime ? Math.min((time - previousTime) / 1000, 0.064) : 0;
            previousTime = time;
            const targetSpeed = hovering || focused ? 0 : 1;
            speed += (targetSpeed - speed) * (1 - Math.exp(-elapsed / 0.3));
            const width = group.offsetWidth;
            if (width > 0) {
                offset = (offset + (width / 55) * speed * elapsed) % width;
                track.style.transform = `translateX(${-offset}px)`;
            }
            frame = requestAnimationFrame(tick);
        }

        function resume() {
            if (reducedMotion.matches) {
                cancelAnimationFrame(frame);
                frame = 0;
                offset = 0;
                track.style.transform = '';
            } else if (!document.hidden && !frame) {
                previousTime = 0;
                frame = requestAnimationFrame(tick);
            }
        }

        marquee.addEventListener('pointerenter', () => { hovering = true; });
        marquee.addEventListener('pointerleave', () => { hovering = false; });
        marquee.addEventListener('focusin', () => { focused = true; });
        marquee.addEventListener('focusout', (event) => {
            focused = event.relatedTarget instanceof Node && marquee.contains(event.relatedTarget);
        });
        document.addEventListener('visibilitychange', resume);
        reducedMotion.addEventListener('change', resume);
        resume();
    }

    function initPage() {
        (async () => {
            try {
                const mod = await import('../scripts/noiseBackground.js');
                if (mod && typeof mod.initNoiseBackground === 'function') {
                    mod.initNoiseBackground(2);
                }
            } catch (e) {
                console.error('initNoiseBackground failed:', e);
            }
        })();

        setupVisibleVideos();
        setupHoverSound();
        setupProjectMarquee();

        (async () => {
            try {
                const mod = await import('../scripts/projectCardBorder.js');
                if (mod && typeof mod.initProjectCardBorders === 'function') {
                    mod.initProjectCardBorders();
                }
            } catch (e) {
                console.error('initProjectCardBorders failed:', e);
            }
        })();
        
    }

    document.addEventListener('astro:page-load', initPage);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage);
    } else {
        initPage();
    }
</script>

<style>
    .hero-section {
        padding-top: 24px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
    }

    /* 下層ページの .sub-header-title と同じ見え方に揃える */
    .site-title {
        font-size: 32px;
        font-weight: normal;
        color: #4ac3e1;
        margin: 0 0 10px 0;
        line-height: 1.2;
        opacity: 0;
        animation: fadeIn 2s ease-out forwards;
        animation-delay: 0.2s;
    }

    .divider-wrapper {
        position: relative;
        height: 20px;
    }

    /* -------------------------------------
       Intro (portrait + typing about text)
       ------------------------------------- */
    .intro-section {
        display: grid;
        grid-template-columns: 17% 1fr;
        gap: 40px;
        align-items: start;
        margin: 40px 0 48px 0;
    }

    .intro-photo {
        position: relative;
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    .intro-photo-inner {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #e5e5e5;
    }

    .intro-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .intro-text {
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .intro-contact {
        margin: 20px 0 0 0;
        font-size: 20px;
        color: #333;
    }

    .intro-contact a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .intro-contact a:hover {
        color: #888;
    }


    .canvas-wrapper {
        position: relative;
        width: 100%;
        transition: height 0.4s ease-out;
    }

    /* canvasの青い文字の上に重なる、透明なリンク領域 */
    .canvas-wrapper :global(.about-link) {
        display: block;
        cursor: pointer;
    }

    .canvas-wrapper canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    @media (max-width: 700px) {
        .intro-section {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }

    .procedural-divider {
        display: block;
        width: 100vw !important;
        max-width: none !important;
        height: 20px;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        margin-top: 0px;
    }

    canvas {
        opacity: 0;
        animation: fadeIn 0.8s ease-out forwards;
        animation-delay: 0.1s; 
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 0px 0 40px 0;
    }

    /* -------------------------------------
       Featured Projects
       ------------------------------------- */
    .featured-section {
        position: relative;
        width: 100%;
        margin-top: 8px;
        margin-bottom: 40px;
    }

    .sound-gain {
        position: absolute;
        right: 16px;
        bottom: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        color: #555;
        font-family: inherit;
        font-size: 16px;
    }

    .sound-gain label {
        font: inherit;
        letter-spacing: normal;
    }

    .sound-gain input {
        --gain-level: 0%;
        appearance: none;
        -webkit-appearance: none;
        width: 112px;
        height: 24px;
        margin: 0;
        background: transparent;
        cursor: pointer;
    }

    .sound-gain input::-webkit-slider-runnable-track {
        height: 12px;
        border: 1px solid #777;
        border-radius: 0;
        box-sizing: border-box;
        background: linear-gradient(to right, #555 var(--gain-level), transparent var(--gain-level));
    }

    .sound-gain input::-moz-range-track {
        height: 10px;
        border: 1px solid #777;
        border-radius: 0;
        background: transparent;
    }

    .sound-gain input::-moz-range-progress { height: 10px; border-radius: 0; background: #555; }

    .sound-gain input::-webkit-slider-thumb {
        appearance: none;
        -webkit-appearance: none;
        width: 4px;
        height: 10px;
        margin-top: 0;
        border: 0;
        border-radius: 0;
        background: #333;
    }

    .sound-gain input::-moz-range-thumb {
        width: 4px;
        height: 10px;
        border: 0;
        border-radius: 0;
        background: #333;
    }

    .sound-gain input:focus-visible {
        outline: 1px solid #555;
        outline-offset: 4px;
    }

    @media (hover: none), (max-width: 700px) {
        .sound-gain { display: none; }
    }


    .section-title {
        font-size: 32px;
        font-weight: normal;
        margin: 0 0 20px 0;
        color: #333;
    }

    .cv-section {
        margin-top: 56px;
    }

    .more-projects-section { margin: -8px 16px 0; }

    .project-marquee { overflow: hidden; padding: 5px; margin: -5px; }

    .project-marquee-track {
        display: flex;
        width: max-content;
        will-change: transform;
    }

    .project-marquee-group {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-right: 20px;
    }

    .project-marquee-item {
        position: relative;
        display: block;
        flex: 0 0 160px;
        width: 160px;
        height: 108px;
        padding: 8px;
        box-sizing: border-box;
        color: #fff;
    }

    .project-marquee-item img { display: block; width: 100%; height: 100%; object-fit: contain; }
    .project-marquee-item span {
        position: absolute;
        inset: auto 8px 8px;
        padding: 16px 8px 8px;
        font-size: 13px;
        line-height: 1.3;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .project-marquee-item:hover span,
    .project-marquee-item:focus-visible span { opacity: 1; }
    .project-marquee-item:focus-visible { outline: 2px solid #333; outline-offset: 3px; }

    @media (max-width: 700px) {
        .project-marquee-item { flex-basis: 128px; width: 128px; height: 86px; }
        .project-marquee-group { gap: 16px; padding-right: 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-marquee { overflow-x: auto; }
        .project-marquee-track { will-change: auto; }
        .project-marquee-group[aria-hidden="true"] { display: none; }
        .project-marquee-item span { transition: none; }
    }

    .view-more { margin: 48px 16px; }
    .view-more h2 { margin: 0 0 8px; font-size: 22px; font-weight: normal; }
    .view-more p { margin: 0; font-size: clamp(16.8px, 3vw, 26.4px); line-height: 1.3; }
    .view-more a { color: inherit; text-underline-offset: 5px; white-space: nowrap; }

    /* CVはページ画像で表示する。どの画面幅でも同じ大きさで読める */
    .cv-pages {
