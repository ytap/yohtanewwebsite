---
import Layout from '../layouts/Layout.astro';

import { getCollection } from 'astro:content';

// 作品データは src/content/projects/*.md から読む (トップと個別ページで共通)
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.map((project) => ({
    title: project.data.title,
    description: project.data.oneLiner,
    image: project.data.poster,
    loop: project.data.loop,
    fit: project.data.fit,
    link: project.data.published ? `/yohtanewwebsite/projects/${project.id}` : null,
}));

const [featureProject, ...subProjects] = featuredProjects;
---

<Layout isHome={true}>
    <div class="main-container">
        <header class="hero-section">
            <h1 class="site-title">Yohta Kitagawa</h1>
            <canvas id="divider-canvas" class="procedural-divider"></canvas>
        </header>

        <section class="intro-section" id="vision">
            <div class="intro-photo">
                <div class="intro-photo-inner">
                    <img src="/yohtanewwebsite/assets/portrait.jpg" alt="Yohta Kitagawa" class="intro-photo-img" />
                </div>
            </div>
            <div class="intro-text">
                <div class="canvas-wrapper">
                    <canvas id="about-canvas" class="procedural-about"></canvas>
                </div>
                <div class="contact-row">
                    <p class="intro-contact">Feel free to contact me at <a href="mailto:ykitagawa@keio.jp">ykitagawa@keio.jp</a> / <a href="https://instagram.com/yohta_kitagawa" target="_blank" rel="noopener noreferrer">Instagram</a></p>
                </div>
            </div>
        </section>

        <section class="featured-section" id="projects">
            <button id="sound-toggle" class="sound-toggle" type="button" aria-pressed="false" aria-label="Turn sound on">
                    <svg class="icon-muted" viewBox="0 0 24 24" width="70" height="70" aria-hidden="true">
                        <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" />
                        <path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
                    </svg>
                    <svg class="icon-sound" viewBox="0 0 24 24" width="70" height="70" aria-hidden="true">
                        <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" />
                        <path d="M16.5 9.5a3.5 3.5 0 0 1 0 5M19 7a7 7 0 0 1 0 10" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
                    </svg>
            </button>

            <div class="projects-layout">
                <a href={featureProject.link} class="project-block project-block-feature">
                    <div class="image-wrapper">
                        {featureProject.loop ? (
                            <video class={featureProject.fit === 'contain' ? 'project-img is-contain' : 'project-img'} poster={featureProject.image} autoplay muted loop playsinline preload="auto">
                                <source src={featureProject.loop.replace('.mp4', '.webm')} type="video/webm" />
                                <source src={featureProject.loop} type="video/mp4" />
                            </video>
                        ) : (
                            <img src={featureProject.image} alt={featureProject.title} class={featureProject.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                        )}
                    </div>
                    <div class="project-text-content">
                        <h3 class="project-block-title">{featureProject.title}</h3>
                        <p class="project-block-desc">{featureProject.description}</p>
                    </div>
                </a>

                <div class="project-sub-grid">
                    {subProjects.map((project) => (
                        project.link ? (
                            <a href={project.link} class="project-block project-block-sub">
                                <div class="image-wrapper">
                                    {project.loop ? (
                                        <video class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} poster={project.image} autoplay muted loop playsinline preload="auto">
                                            <source src={project.loop.replace('.mp4', '.webm')} type="video/webm" />
                                            <source src={project.loop} type="video/mp4" />
                                        </video>
                                    ) : (
                                        <img src={project.image} alt={project.title} class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                                    )}
                                </div>
                                <div class="project-text-content">
                                    <h3 class="project-block-title">{project.title}</h3>
                                </div>
                            </a>
                        ) : (
                            <div class="project-block project-block-sub is-upcoming">
                                <div class="image-wrapper">
                                    {project.loop ? (
                                        <video class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} poster={project.image} autoplay muted loop playsinline preload="auto">
                                            <source src={project.loop.replace('.mp4', '.webm')} type="video/webm" />
                                            <source src={project.loop} type="video/mp4" />
                                        </video>
                                    ) : (
                                        <img src={project.image} alt={project.title} class={project.fit === 'contain' ? 'project-img is-contain' : 'project-img'} />
                                    )}
                                </div>
                                <div class="project-text-content">
                                    <h3 class="project-block-title">{project.title}</h3>
                                </div>
                            </div>
                        )
                    ))}
                </div>
            </div>
        </section>

        <section class="cv-section" id="cv">
            <div class="cv-embed">
                <iframe src="/yohtanewwebsite/assets/Yohta_Kitagawa_CV.pdf" title="Yohta Kitagawa CV"></iframe>
            </div>
            <p class="cv-link"><a href="/yohtanewwebsite/assets/Yohta_Kitagawa_CV.pdf" target="_blank" rel="noopener noreferrer">→ Open CV as PDF</a></p>

            {/* 埋め込みPDFの中のリンクはDrive側の制限で開けないため、同じリンクをここに並べておく */}
            <div class="cv-links">
                <div class="cv-links-group">
                    <h3 class="cv-links-title">Papers</h3>
                    <ul>
                        <li><a href="https://drive.google.com/file/d/1m-BNBD6vwnPbsP8USmHxWUY8O4puRIaX/view" target="_blank" rel="noopener noreferrer">Contact Membrane — SIGGRAPH Asia 2026 Art Papers</a></li>
                        <li><a href="https://drive.google.com/file/d/1vsCOKhJakygJK4sK4imKwEAZeH-F5iPs/view" target="_blank" rel="noopener noreferrer">Knot-music</a></li>
                        <li><a href="https://drive.google.com/file/d/1V1u49kPSAruoYXEBNlxZtJlfUSdHNxpq/view" target="_blank" rel="noopener noreferrer">Tele-Bio — ACM UIST 2026 Student Innovation Contest</a></li>
                        <li><a href="https://drive.google.com/file/d/1LuURZza8ffsDptJcvqLLxj78bsunm9E0/view" target="_blank" rel="noopener noreferrer">Motioning</a></li>
                    </ul>
                </div>

                <div class="cv-links-group">
                    <h3 class="cv-links-title">Videos</h3>
                    <ul>
                        <li><a href="/yohtanewwebsite/projects/contact-membrane">Contact Membrane</a></li>
                        <li><a href="/yohtanewwebsite/projects/knot-music">Knot-music</a></li>
                        <li><a href="/yohtanewwebsite/projects/noiseloom">NoiseLoom</a></li>
                        <li><a href="https://drive.google.com/file/d/15BqrXga3WOnNYGmkFKo42O117GeZ5Dsi/view" target="_blank" rel="noopener noreferrer">Supplementary video</a></li>
                    </ul>
                </div>
            </div>
        </section>

        </div>
    </Layout>

<script>
    import '../scripts/pages/main-canvas.js';

    // 作品のループ映像: 通常はミュート、hoverしている1本だけ音を出す
    function setupHoverSound() {
        const toggle = document.getElementById('sound-toggle');
        const blocks = Array.from(document.querySelectorAll('.project-block'));
        if (!toggle || blocks.length === 0) return;

        // hoverできない端末 (スマホなど) では音を扱わない
        if (!window.matchMedia('(hover: hover)').matches) return;

        const videos = blocks
            .map(block => ({ block, video: block.querySelector('video') }))
            .filter(entry => entry.video);
        if (videos.length === 0) return;

        // hover時の音量 (0〜1)。上げ下げはこの数値だけで調整できる
        const HOVER_VOLUME = 0.4;

        let soundOn = false;
        let current = null;
        // フェードのタイマーは動画ごとに持つ (共有すると前の動画が鳴りっぱなしになる)
        const fadeTimers = new WeakMap();

        function fadeTo(video, target) {
            const running = fadeTimers.get(video);
            if (running) window.clearInterval(running);
            const id = window.setInterval(() => {
                const step = 0.04;
                const next = target > video.volume ? video.volume + step : video.volume - step;
                const done = target > video.volume ? next >= target : next <= target;
                video.volume = done ? target : next;
                if (done) {
                    window.clearInterval(id);
                    fadeTimers.delete(video);
                    if (target === 0) video.muted = true;
                }
            }, 25);
            fadeTimers.set(video, id);
        }

        function muteNow(video) {
            const running = fadeTimers.get(video);
            if (running) {
                window.clearInterval(running);
                fadeTimers.delete(video);
            }
            video.muted = true;
            video.volume = 0;
        }

        // hover中の1本以外は必ずミュートに戻す
        function enforce() {
            videos.forEach(({ video }) => {
                if (video !== current) {
                    if (!video.muted || video.volume > 0) muteNow(video);
                }
            });
        }

        function stopCurrent() {
            if (!current) return;
            const video = current;
            current = null;
            fadeTo(video, 0);
        }

        function playSound(video) {
            if (!soundOn || !video) return;
            if (current && current !== video) muteNow(current);
            current = video;
            video.volume = 0;
            video.muted = false;
            fadeTo(video, HOVER_VOLUME);
            const p = video.play();
            if (p && typeof p.catch === 'function') {
                p.catch(() => {
                    muteNow(video);
                    if (current === video) current = null;
                });
            }
        }

        videos.forEach(({ block, video }) => {
            block.addEventListener('mouseenter', () => playSound(video));
            block.addEventListener('mouseleave', () => {
                if (current === video) stopCurrent();
                else muteNow(video);
            });
        });

        // グリッドの外に出たとき、タブが隠れたときは全部止める
        const section = document.getElementById('projects');
        if (section) {
            section.addEventListener('mouseleave', () => {
                stopCurrent();
                enforce();
            });
        }
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                current = null;
                videos.forEach(({ video }) => muteNow(video));
            }
        });
        window.addEventListener('blur', () => {
            current = null;
            videos.forEach(({ video }) => muteNow(video));
        });

        toggle.addEventListener('click', () => {
            soundOn = !soundOn;
            toggle.classList.toggle('is-on', soundOn);
            toggle.setAttribute('aria-pressed', String(soundOn));
            toggle.setAttribute('aria-label', soundOn ? 'Turn sound off' : 'Turn sound on');
            if (!soundOn) {
                current = null;
                videos.forEach(({ video }) => muteNow(video));
            }
        });
    }

    function initPage() {
        (async () => {
            try {
                const mod = await import('../scripts/noiseBackground.js');
                if (mod && typeof mod.initNoiseBackground === 'function') {
                    mod.initNoiseBackground(2);
                }
            } catch (e) {
                console.error('initNoiseBackground failed:', e);
            }
        })();

        setupHoverSound();

        (async () => {
            try {
                const mod = await import('../scripts/projectCardBorder.js');
                if (mod && typeof mod.initProjectCardBorders === 'function') {
                    mod.initProjectCardBorders();
                }
            } catch (e) {
                console.error('initProjectCardBorders failed:', e);
            }
        })();
        
    }

    document.addEventListener('astro:page-load', initPage);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage);
    } else {
        initPage();
    }
</script>

<style>
    .hero-section {
        padding-top: 24px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
    }

    /* 下層ページの .sub-header-title と同じ見え方に揃える */
    .site-title {
        font-size: 32px;
        font-weight: normal;
        color: #4ac3e1;
        margin: 0 0 10px 0;
        line-height: 1.2;
        opacity: 0;
        animation: fadeIn 2s ease-out forwards;
        animation-delay: 0.2s;
    }

    /* -------------------------------------
       Intro (portrait + typing about text)
       ------------------------------------- */
    .intro-section {
        display: grid;
        grid-template-columns: 17% 1fr;
        gap: 40px;
        align-items: start;
        margin: 40px 0 48px 0;
    }

    .intro-photo {
        position: relative;
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    .intro-photo-inner {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #e5e5e5;
    }

    .intro-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .intro-text {
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .intro-contact {
        margin: 20px 0 0 0;
        font-size: 20px;
        color: #333;
    }

    .intro-contact a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .intro-contact a:hover {
        color: #888;
    }


    .canvas-wrapper {
        position: relative;
        width: 100%;
        transition: height 0.4s ease-out;
    }

    /* canvasの青い文字の上に重なる、透明なリンク領域 */
    .canvas-wrapper :global(.about-link) {
        display: block;
        cursor: pointer;
    }

    .canvas-wrapper canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    @media (max-width: 700px) {
        .intro-section {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }

    .procedural-divider {
        display: block;
        width: 100vw !important;
        max-width: none !important;
        height: 20px;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        margin-top: 0px;
    }

    canvas {
        opacity: 0;
        animation: fadeIn 0.8s ease-out forwards;
        animation-delay: 0.1s; 
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 0px 0 40px 0;
    }

    /* -------------------------------------
       Featured Projects
       ------------------------------------- */
    .featured-section {
        width: 100%;
        margin-top: 8px;
        margin-bottom: 40px;
    }

    .section-title {
        font-size: 32px;
        font-weight: normal;
        margin: 0 0 20px 0;
        color: #333;
    }

    .cv-section {
        margin-top: 56px;
    }

    .cv-embed {
        width: 100%;
        height: 80vh;
        max-height: 900px;
        border: 1px solid #ccc;
        background-color: #fff;
        margin-bottom: 16px;
    }

    .cv-embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }

    /* モバイル (特にiOS Safari) はPDFのiframe表示が不安定なため、リンクだけ出す */
    @media (max-width: 700px) {
        .cv-embed {
            display: none;
        }
    }

    .cv-link {
        margin: 0;
        font-size: 20px;
    }

    .cv-link a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .cv-link a:hover {
        color: #888;
    }

    .cv-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px 40px;
        margin-top: 28px;
    }

    .cv-links-title {
        font-size: 20px;
        font-weight: normal;
        color: #333;
        margin: 0 0 10px 0;
    }

    .cv-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
    }

    .cv-links li {
        margin-bottom: 10px;
        padding-left: 18px;
        position: relative;
    }

    .cv-links li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: #888;
    }

    .cv-links a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }

    .cv-links a:hover {
        color: #888;
    }

    @media (max-width: 700px) {
        .cv-links {
            grid-template-columns: 1fr;
        }
    }

    /* プロジェクトのボックスの真上・右端。浮かせてあるので下のグリッドは動かない */
    .featured-section {
        position: relative;
    }

    .featured-section .sound-toggle {
        position: absolute;
        right: 0;
        bottom: 100%;
    }

    .sound-toggle {
        background: none;
        border: none;
        padding: 4px;
        cursor: pointer;
        color: #888;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
    }

    .sound-toggle:hover {
        color: #333;
    }

    /* 音が出る状態のときだけスピーカーのアイコンに切り替える */
    .sound-toggle .icon-sound {
        display: none;
    }

    .sound-toggle.is-on {
        color: #333;
    }

    .sound-toggle.is-on .icon-muted {
        display: none;
    }

    .sound-toggle.is-on .icon-sound {
        display: block;
    }

    /* hoverが無い端末では音を扱わないので、トグル自体を出さない */
    @media (hover: none), (max-width: 700px) {
        .sound-toggle {
            display: none;
        }
    }

    .projects-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .project-sub-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .project-block {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        padding: 16px;
        background-color: transparent;
        border-radius: 6px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.2s ease;
    }

    .project-block:hover {
        background-color: #eeeeee;
    }

    .image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 2;
        border: 2px solid transparent;
        box-sizing: border-box;
        overflow: hidden;
        background-color: #f0f0f0;
    }

    .project-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .project-img.is-contain {
        object-fit: contain;
        background-color: #fff;
    }

    /* タイトルと説明は画像に重ね、hoverしたときだけ見せる */
    .project-text-content {
        /* カード自体のpaddingぶん内側に寄せて、画像の上にちょうど重ねる */
        position: absolute;
        left: 16px;
        right: 16px;
        bottom: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px;
        box-sizing: border-box;
        color: #fff;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0));
        opacity: 0;
        transition: opacity 0.25s ease;
        pointer-events: none;
    }

    .project-block:hover .project-text-content,
    .project-block:focus-visible .project-text-content {
        opacity: 1;
    }

    .project-block-title {
        font-size: clamp(18px, 1.8vw, 28px);
        font-weight: bold;
        margin: 0;
        line-height: 1.1;
    }

    .project-block-desc {
        font-size: clamp(13px, 1.05vw, 17px);
        color: #eee;
        margin: 0;
        line-height: 1.5;
    }

    .project-block-feature .image-wrapper {
        aspect-ratio: 3 / 2;
    }

    .project-block-sub {
        padding: 8px;
        gap: 8px;
    }

    .project-block-sub .project-text-content {
        left: 8px;
        right: 8px;
        bottom: 8px;
        padding: 10px;
    }

    .project-block-sub .image-wrapper {
        aspect-ratio: 3 / 2;
    }

    .project-block-sub .project-block-title {
        font-size: clamp(14px, 1.1vw, 18px);
    }

    .is-upcoming {
        cursor: default;
    }

    @media (max-width: 700px) {
        .projects-layout {
            grid-template-columns: 1fr;
            gap: 20px;
        }
    }

</style>