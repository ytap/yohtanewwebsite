---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Vision: Yohta Kitagawa">
    <div class="main-container">
        <p class="vision-lead">What if we ask, "How can we connect to an already animate world"<br />rather than "How can we make the world animate?"</p>

        <section class="vision-intro">
            <div class="vision-summary">
                <p>The world is already changing before we notice it.</p>
                <p>Mediating Animacy explores interfaces that make subtle changes in other beings, materials, and environments perceptible.</p>
                <p>By responding to these changes, we enter relationships that were already underway, and potentially animate. Through this, mediating animacy aims to question how computational media may make something feel alive, or objectify them.</p>
            </div>

            <div class="vision-diagram">
                <img src="/yohtanewwebsite/assets/animacy-diagram-v2.jpg" alt="Diagram: needs-driven HCI compared with Mediating Animacy" />
            </div>
            <div class="vision-photo">
                <img src="/yohtanewwebsite/assets/shoryuuma.png" alt="Shoryuuma" />
            </div>
        </section>

        <p class="pdf-note">Unpublished manuscript, 2026. Not peer reviewed.</p>

        <div class="pdf-embed">
            <iframe src="/yohtanewwebsite/assets/mediatingAnimacyV1.pdf#zoom=page-width" title="Mediating Animacy"></iframe>
        </div>
        <p class="pdf-link"><a href="/yohtanewwebsite/assets/mediatingAnimacyV1.pdf" target="_blank" rel="noopener noreferrer">→ Open as PDF</a></p>
    </div>
</Layout>

<style>
    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 24px 0 80px 0;
    }

    /* 1行目の高さはテキストが決め、ダイアグラムは元の枠内に収める */
    .vision-intro {
        display: grid;
        grid-template-columns: clamp(260px, 34%, 460px) minmax(0, 1fr);
        column-gap: 48px;
        row-gap: 24px;
        margin-bottom: 56px;
    }

    .vision-summary {
        grid-column: 2;
        grid-row: 1;
        min-width: 0;
    }

    /* 元のダイアグラムと同じく、説明文の高さを上限に収める */
    .vision-diagram {
        grid-column: 1;
        grid-row: 1;
        position: relative;
        min-height: 260px;
    }

    .vision-diagram img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        display: block;
    }

    .vision-photo {
        grid-column: 1;
        grid-row: 2;
        width: min(100%, 360px);
    }

    .vision-photo img {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (max-width: 700px) {
        .vision-intro {
            grid-template-columns: 1fr;
            row-gap: 24px;
        }

        .vision-diagram {
            position: static;
            min-height: 0;
        }

        .vision-diagram img {
            position: static;
            height: auto;
        }

        .vision-photo {
            width: min(100%, 320px);
        }

        .vision-summary {
            grid-column: 1;
            grid-row: 3;
        }
    }

    /* 見出しは横幅いっぱい */
    .vision-lead {
        font-size: 40px;
        line-height: 1.3;
        color: #333;
        margin: 0 0 36px 0;
    }

    .vision-summary {
        margin-bottom: 0;
    }

    .vision-summary p {
        font-size: 30px;
        line-height: 1.55;
        color: #333;
        margin: 0 0 20px 0;
    }

    .pdf-note {
        max-width: 1100px;
        margin: 0 auto 12px auto;
        font-size: 18px;
        color: #888;
    }

    /* PDFは埋め込みのまま。枠を紙に近い縦横比にして中央に置く */
    .pdf-embed {
        width: 100%;
        max-width: 1100px;
        aspect-ratio: 1 / 1.32;
        margin: 0 auto 16px auto;
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .pdf-embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }

    /* モバイル (特にiOS Safari) はPDFのiframe表示が不安定なため、リンクだけ出す */
    @media (max-width: 700px) {
        .pdf-embed {
            display: none;
        }
    }

    .pdf-link {
        margin: 0;
        text-align: center;
        font-size: 20px;
    }

    .pdf-link a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .pdf-link a:hover {
        color: #888;
    }
</style>
