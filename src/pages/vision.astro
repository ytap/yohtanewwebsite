---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vision: Yohta Kitagawa">
    <div class="main-container">
        <div class="pdf-embed">
            <iframe src="/yohtanewwebsite/assets/mediatingAnimacyV1.pdf#view=FitH&toolbar=1" title="Mediating Animacy"></iframe>
        </div>
        <p class="pdf-link"><a href="/yohtanewwebsite/assets/mediatingAnimacyV1.pdf" target="_blank" rel="noopener noreferrer">→ Open as PDF</a></p>
    </div>
</Layout>

<style>
    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 24px 0 80px 0;
    }

    .pdf-embed {
        width: 100%;
        height: 80vh;
        max-height: 900px;
        border: 1px solid #ccc;
        background-color: #fff;
        margin-bottom: 16px;
    }

    .pdf-embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }

    /* モバイル (特にiOS Safari) はPDFのiframe表示が不安定なため、リンクだけ出す */
    @media (max-width: 700px) {
        .pdf-embed {
            display: none;
        }
    }

    .pdf-link {
        margin: 0;
        font-size: 20px;
    }

    .pdf-link a {
        color: #333;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .pdf-link a:hover {
        color: #888;
    }
</style>
