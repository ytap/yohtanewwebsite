---
// src/layouts/Layout.astro
interface Props {
    title?: string;
    isHome?: boolean;
    isWip?: boolean;
}

const { title = "Portfolio: Yohta Kitagawa", isHome = false, isWip = false } = Astro.props;
---
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>{title}</title>
    <style is:global>
        @font-face {
            font-family: 'CothamSans';
            src: url('/yohtanewwebsite/fonts/CothamSans.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        body {
            font-family: CothamSans, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--body-bg, #f5f5f5);
            color: var(--body-color, #333);
            overflow-x: hidden;
        }

        .main-container {
            width: 86vw;
            margin: 0 auto;
            padding: 0px 0 40px 0;
        }

        .hero-section {
            padding-top: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            gap: 0px;
            width: 100%;
        }

        /* 💡 下層ページ専用のヘッダー定義を追加（メインページと縦座標を完全に一致させる） */
        .sub-hero-section {
            padding-top: 30px;       /* メインページのhero-section(20px)+タイトルのstartY(10px)に揃えた数値 */
            padding-bottom: 0;       /* 波線の直下にコンテンツが続くため余白なし */
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            gap: 0px;
            width: 100%;
        }

        .sub-header-title {
            font-size: 32px;
            font-weight: normal;
            margin: 0 0 10px 0;
            line-height: 1.2;
            opacity: 0;
            /* Mainページのキャンバス文字エフェクトが完成するまでの時間(約0.2s遅延+約2s)に揃えている */
            animation: fadeIn 2s ease-out forwards;
            animation-delay: 0.2s;
        }
        .sub-header-title a {
            color: #4ac3e1;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }
        .sub-header-title a:hover {
            opacity: 0.7;
        }

        .procedural-divider {
            width: 100vw !important;
            max-width: none !important;
            height: 20px;
            position: relative;
            left: 50%;
            transform: translateX(-50%);
            margin-top: 0px;
        }

        canvas {
            opacity: 0;
            animation: fadeIn 0.8s ease-out forwards;
            animation-delay: 0.1s;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .site-nav {
            position: fixed;
            top: 2rem;
            right: 2vw;
            z-index: 100;
            display: flex;
            gap: 28px;
        }

        .site-nav a {
            font-family: inherit;
            font-size: 20px;
            color: #333;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .site-nav a:hover {
            color: #888;
        }

    </style>
</head>
<body data-is-home={String(isHome)} data-is-wip={String(isWip)}>
    <nav class="site-nav">
        <a href="/yohtanewwebsite/vision">Vision</a>
    </nav>

    {!isHome && (
        <div class="main-container" style="padding-bottom:0">
            <header class="sub-hero-section">
                <h1 class="sub-header-title">
                    <a href="/yohtanewwebsite/">Yohta Kitagawa</a>
                </h1>
                <canvas id="divider-canvas" class="procedural-divider"></canvas>
            </header>
        </div>
    )}

    <main>
        <slot />
    </main>

    <script is:inline>
        // CVのPDFビューア(iframe)の中からサイト内リンクを踏むと、
        // サイトの中にサイトが表示されてしまうため、最前面のウィンドウに開き直す
        (function () {
            try {
                if (window.top !== window.self) {
                    window.top.location.replace(window.location.href);
                }
            } catch (e) {
                // 別オリジンに埋め込まれている場合は何もしない
            }
        })();
    </script>

    <script src="../scripts/layoutInit.js"></script>
</body>
</html>