---
import Layout from './Layout.astro';

const { title, image } = Astro.props;
---

<Layout title={title}>
    <div class="main-container">
        <header class="project-header">
            <h1>{title}</h1>
        </header>

        <article class="project-body">
            {image && (
                <div class="image-wrapper project-image-wrapper">
                    <img src={image} alt={title} class="project-img" />
                </div>
            )}

            <div class="content-text">
                <slot />
            </div>
        </article>
    </div>
</Layout>

<style>
    .main-container {
        width: 86vw;
        margin: 0 auto;
        padding: 16px 0 60px 0;
    }

    .project-header h1 {
        font-size: 84px;
        font-weight: normal;
        margin: 0 0 16px 0;
        color: #333;
        line-height: 1.05;
    }

    .project-body {
        display: flex;
        flex-direction: row;
        gap: 48px;
        align-items: flex-start;
    }

    .image-wrapper {
        flex: 0 0 52%;
        position: relative;
        background-color: #f0f0f0;
    }

    .project-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .content-text {
        flex: 1;
        min-width: 0;
        padding-top: 4px;
    }

    :global(.content-text p) {
        font-size: 22px;
        line-height: 1.6;
        color: #333;
        margin: 0 0 20px 0;
        white-space: pre-line;
    }
</style>