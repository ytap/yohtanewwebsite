---
// 動画の埋め込み (Google Drive / YouTube 共通)
// drive: 共有リンクのファイルID, youtube: 動画ID を渡す
const { drive, youtube, title = 'video' } = Astro.props;

const src = drive
    ? `https://drive.google.com/file/d/${drive}/preview`
    : `https://www.youtube.com/embed/${youtube}?rel=0&modestbranding=1`;
---

<div class="video-embed">
    <iframe
        src={src}
        title={title}
        allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
    ></iframe>
</div>

<style>
    /* 16:9を保ったままレスポンシブに表示する */
    .video-embed {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-bottom: 24px;
        background-color: #f0f0f0;
    }

    .video-embed iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }
</style>
